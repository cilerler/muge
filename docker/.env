NAMESPACE=default
# COMPOSE_FILE=docker-compose.yml
# COMPOSE_PROJECT_NAME=muge
DEV_CERTS_PASSWORD=passworddevcerts


# seq UI/API at http://host.docker.internal:15341 / http://host.docker.internal:5341
SEQ_FIRSTRUN_ADMINUSERNAME=useradmin
SEQ_FIRSTRUN_ADMINPASSWORD=passwordadmin1


# redis at host.docker.internal:6379
REDIS_PASSWORD=passwordadmin
# Bind mount source for redis:/data
REDIS_BINDMOUNT_0=~/.docker/volumes/muge/redis/data
# Bind mount source for redisinsight:/db
REDISINSIGHT_BINDMOUNT_0=~/.docker/volumes/muge/redis-insight/data

# rabbitmq management UI at http://host.docker.internal:15672, AMQP at 5672
RABBITMQ_USERNAME=useradmin
RABBITMQ_PASSWORD=passwordadmin
# Bind mount source for rabbitmq:/usr/lib/rabbitmq/mnesia
RABBITMQ_BINDMOUNT_0=~/.docker/volumes/muge/rabbitmq/mnesia
# Bind mount source for rabbitmq:/usr/lib/rabbitmq/plugins
RABBITMQ_BINDMOUNT_1=~/.docker/volumes/muge/rabbitmq-plugins
# Version of the rabbitmq_delayed_message_exchange plugin (fetched by rabbitmq-init)
RABBITMQ_DELAYED_EXCHANGE_VERSION=4.2.0


# mssql at host.docker.internal:1433
MSSQL_USERNAME=sa
MSSQL_PASSWORD=PasswordAdmin1!
# Bind mount source for mssql:/var/opt/mssql/data
MSSQL_BINDMOUNT_0=~/.docker/volumes/muge/mssql/data
# Bind mount source for mssql:/var/opt/mssql/log
MSSQL_BINDMOUNT_1=~/.docker/volumes/muge/mssql/log
# Bind mount source for mssql:/var/opt/mssql/secrets
MSSQL_BINDMOUNT_2=~/.docker/volumes/muge/mssql/secrets

# Parameter dfm-username
DFM_USERNAME=sa
# Parameter dfm-password
DFM_PASSWORD=PasswordAdmin1!

# Bind mount source for linqpad-dapr:/localstorage
DAPR_LOCALSTORAGE_BINDMOUNT=C:/.ignore/localstorage
